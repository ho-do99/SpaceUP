# Copy to /root/spaceup-public.env on the public server.
COMPOSE_PROJECT_NAME=spaceup-dev
IMAGE_REGISTRY=ghcr.io/ho-do99
DOMAIN=spaceup.duckdns.org
LEGACY_DOMAIN=101.79.26.89.sslip.io
BACKEND_HOST=10.10.20.6
AI_HOST=10.10.20.6
NGINX_BIND_HOST=0.0.0.0
NGINX_PORT=80
NGINX_SSL_PORT=443
LETSENCRYPT_DIR=/etc/letsencrypt
CERTBOT_WEBROOT_DIR=/var/lib/letsencrypt
SSL_CERT_PATH=/etc/nginx/certs/live/spaceup.duckdns.org/fullchain.pem
SSL_KEY_PATH=/etc/nginx/certs/live/spaceup.duckdns.org/privkey.pem
LEGACY_SSL_CERT_PATH=/etc/nginx/certs/live/101.79.26.89.sslip.io/fullchain.pem
LEGACY_SSL_KEY_PATH=/etc/nginx/certs/live/101.79.26.89.sslip.io/privkey.pem
