COMPOSE_PROJECT_NAME=spaceup-local

# Database Connection (Configure in your local .env or .env.local)
DB_HOST=localhost
DB_PORT=3306
DB_USER=your_db_user
DB_PASSWORD=your_db_password
DB_NAME=your_db_name

MYSQL_DATABASE=spaceup
MYSQL_USER=spaceup_user
MYSQL_PASSWORD=change-me
MYSQL_ROOT_PASSWORD=change-root-password
MYSQL_PORT=3306
AI_PORT=8000
BACKEND_PORT=8080
FRONTEND_PORT=5173
NGINX_PORT=80
APP_CORS_ALLOWED_ORIGINS=http://localhost,http://localhost:5173
VITE_API_BASE_URL=/api
VITE_API_PROXY_TARGET=http://backend:8080
