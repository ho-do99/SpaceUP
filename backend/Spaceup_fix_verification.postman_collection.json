			"name": "1. 회원가입 (임대인)",
			"event": [
				{
					"listen": "prerequest",
					"script": {
						"type": "text/javascript",
						"exec": [
							"pm.collectionVariables.set('username', 'tester_' + Date.now());"
						]
					}
				},
				{
					"listen": "test",
					"script": {
						"type": "text/javascript",
						"exec": [
							"pm.test('회원가입 성공 (200, success=true)', function () {",
							"    pm.response.to.have.status(200);",
							"    pm.expect(pm.response.json().success).to.eql(true);",
							"});"
						]
					}
				}
			],
			"request": {
				"method": "POST",
				"header": [ { "key": "Content-Type", "value": "application/json" } ],
				"body": {
					"mode": "raw",
					"raw": "{\n    \"role\": \"LANDLORD\",\n    \"username\": \"{{username}}\",\n    \"password\": \"{{password}}\",\n    \"email\": \"{{username}}@example.com\",\n    \"name\": \"테스터\",\n    \"phoneNumber\": \"010-1234-5678\"\n}"
				},
				"url": {
					"raw": "{{base_url}}/api/member/join",
					"host": [ "{{base_url}}" ],
					"path": [ "api", "member", "join" ]
				}
			}
		},
		{
			"name": "2. 로그인",
			"event": [
				{
					"listen": "test",
					"script": {
						"type": "text/javascript",
						"exec": [
							"pm.test('로그인 성공 및 토큰 발급', function () {",
							"    pm.response.to.have.status(200);",
							"    var data = pm.response.json();",
							"    pm.expect(data.success).to.eql(true);",
							"    pm.expect(data.data.accessToken).to.be.a('string').and.not.empty;",
							"    pm.collectionVariables.set('token', data.data.accessToken);",
							"});"
						]
					}
				}
			],
			"request": {
				"method": "POST",
				"header": [ { "key": "Content-Type", "value": "application/json" } ],
				"body": {
					"mode": "raw",
					"raw": "{\n    \"username\": \"{{username}}\",\n    \"password\": \"{{password}}\"\n}"
